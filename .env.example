# ---- RECON Reverse IP Lookup - environment configuration ----
# Copy to ".env" and edit. The systemd unit loads this file.

# REQUIRED: credentials for HTTP Basic Auth (change these!)
RECON_USER=admin
RECON_PASS=change-me-to-a-long-random-secret

# Where result .txt files are written
RECON_RESULTS_DIR=/var/www/recon/results

# Bind address/port. Keep 127.0.0.1 when running behind the nginx TLS proxy
# (recommended). Only expose 0.0.0.0 if you fully understand the risk.
RECON_HOST=127.0.0.1
RECON_PORT=8000

# Safety / performance limits (tuned for a 1 GB VPS)
RECON_MAX_HOSTS=65536
RECON_DNS_CONCURRENCY=50
RECON_DNS_TIMEOUT=3.0
RECON_DNS_LIFETIME=5.0

# Optional: comma-separated resolvers (leave blank to use system resolvers)
RECON_NAMESERVERS=

# API-free reverse-IP discovery (ON by default). Reads the TLS certificate each
# IP presents and harvests hostnames from its SAN/CN fields. No quota, no third
# party - it talks only to the target. On SNI-based shared hosting a bare grab
# sees only the default cert (partial coverage); CDN IPs return an edge cert.
RECON_ENABLE_TLS_CERT=true
# Comma-separated TLS ports to probe per IP. 443 covers most web hosting; add
# e.g. 8443,993,995,465 to also mine admin panels / mail certs (slower).
RECON_TLS_CERT_PORTS=443
RECON_TLS_CERT_TIMEOUT=4.0
# Max concurrent TLS grabs (defaults to RECON_DNS_CONCURRENCY). Bounds sockets.
RECON_TLS_CERT_CONCURRENCY=50

# Optional third-party shared-hosting reverse-IP API fallback (off by default).
# When enabled, IPs are also sent to this external service - review its terms.
# NOTE: the default (hackertarget) free tier allows only ~50 lookups/day per
# source IP. That is fine for a handful of IPs but will NOT cover a whole /24;
# once exhausted the scan surfaces a rate-limit warning instead of silent zeros.
RECON_ENABLE_EXTERNAL_API=false
RECON_EXTERNAL_API_URL=https://api.hackertarget.com/reverseiplookup/?q={ip}
RECON_EXTERNAL_API_TIMEOUT=10.0
RECON_EXTERNAL_API_CONCURRENCY=3
# Per-IP external-result cache size (entries). Lets repeat scans reuse results
# without spending more of the daily quota. Set 0 to disable the cache.
RECON_EXTERNAL_API_CACHE_MAX=2000
